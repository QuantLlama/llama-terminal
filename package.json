{
  "name": "Quantum-llama-Terminal",
  "version": "1.9.0",
  "description": "Quantum Llama Trading Platform - Desktop Edition",
  "main": "electron/index.js",
  "scripts": {
    "start": "electron .",
    "obfuscate-backend": "node scripts/run-venv.js scripts/build_backend.py",
    "obfuscate-js": "npx electron scripts/build_js.js",
    "dist": "npm run obfuscate-backend && npm run obfuscate-js && electron-builder",
    "pack": "npm run obfuscate-backend && npm run obfuscate-js && electron-builder --dir"
  },
  "build": {
    "appId": "com.quantumllama.desktop",
    "productName": "Quantum Llama Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      {"from": "build/electron", "to": "electron", "filter": ["index.js", "main.js", "main.jsc", "preload.js", "preload.jsc", "preload-loader.js", "health.js", "splash.html", "trial-expired.html"]},
      {"from": "images", "to": "images", "filter": ["QuantumLLama.ico", "QuantumLLama.png"]},
      "package.json",
      "node_modules/**/*",
      "!**/.env{,.*}",
      "!**/*.{key,pem,p12,pfx}",
      "!**/*accounts*.json",
      "!**/outputs/**"
    ],
    "extraResources": [
      {
        "from": "build/pyinstaller_dist",
        "filter": [
          "backend", "Trainer", "BrowserMode",
          "backend.exe", "Trainer.exe", "BrowserMode.exe"
        ],
        "to": "."
      },
      {
        "from": "build/obf_src/src/indicators",
        "to": "src/indicators"
      },
      {
        "from": "build/obf_src/src/algorithms",
        "to": "src/algorithms"
      },
      {
        "from": "build/obf_src/src/features/indicators.py",
        "to": "src/features/indicators.py"
      },
      {
        "from": "build/obf_src/src/live",
        "to": "src/live"
      },
      {
        "from": "build/obf_src/src/doctecnicaalgos",
        "to": "src/doctecnicaalgos"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "images/QuantumLLama.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "nsis/installer.nsh",
      "license": "legal/EULA.txt"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "images/QuantumLLama.png",
      "category": "Utility"
    },
    "deb": {
      "compression": "gz"
    }
  },
  "author": "Trae <contacto@quantumllama.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^29.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "bytenode": "^1.5.7",
    "monaco-editor": "^0.44.0",
    "tree-kill": "^1.2.2",
    "wait-on": "^9.0.4"
  }
}
