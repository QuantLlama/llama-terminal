# Git attributes — line-ending and binary handling.
# Normalize new text without silently renormalizing existing CRLF history.
# Editors use .editorconfig for LF; a historical conversion is a separate change.
* text=auto whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.sh            text eol=lf
*.service       text eol=lf
*.py            text=auto
*.js            text=auto
*.jsx           text=auto
*.json          text=auto
*.md            text=auto
*.yml           text=auto
*.yaml          text=auto

# Binaries — never diffed or normalized.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.gif           binary
*.webp          binary
*.mp3           binary
*.ttf           binary
*.so            binary
*.jsc           binary
*.exe           binary
*.dll           binary
*.pacman        binary
*.deb           binary
*.AppImage      binary
*.db            binary

# Linguist: keep documentation and configuration out of the language statistics.
docs/**         linguist-documentation
odd/**          linguist-documentation
openspec/**     linguist-documentation
deploy/**       linguist-documentation
images/**       linguist-documentation
legal/**        linguist-documentation
