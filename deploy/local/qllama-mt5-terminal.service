[Unit]
Description=Quantum Llama MT5 terminal (Wine, manual start)
# The bridge boots this terminal on demand while a platform session is open, so
# the unit exists only for starting it by hand. It must not start at login and
# must not restart itself: a terminal that reappears seconds after being closed
# is exactly the "MT5 opens by itself" behaviour it used to cause.
#
# Manual start:
#   systemctl --user start qllama-mt5-terminal.service
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# Runs from the system disk on purpose: see qllama-mt5-bridge.service.
WorkingDirectory=%h/.local/share/qllama/runtime
# Wine's fixme spam is useless here and buries the bridge's own messages.
Environment=WINEDEBUG=-all
# The display is resolved by the script, not hardcoded here.
ExecStart=/bin/bash -lc 'exec scripts/start_mt5_terminal.sh'
# No restart policy, deliberately. The bridge is what boots the terminal on
# demand (POST /api/terminal/demand, renewed only by an open platform session),
# and the operator closes it whenever they want.
Restart=no

[Install]
WantedBy=default.target
