[Unit]
Description=Quantum Llama MT5 local bridge (Wine)
# The terminal is NOT pulled in here: the bridge boots it on demand while a
# platform session is open (POST /api/terminal/demand), so starting this unit at
# login must not open a MetaTrader window by itself.
After=network-online.target graphical-session.target
Wants=network-online.target graphical-session.target
# The cloud app depends on this bridge for every MT5 request; keep retrying
# instead of leaving the platform without MT5 until the next boot.
StartLimitIntervalSec=0

[Service]
Type=simple
# Runs from the system disk on purpose. See qllama-crypto-proxy.service: the
# repository lives on an encrypted removable volume that is not mounted when the
# unit starts. Install the runtime with scripts/install_bridge_runtime.sh.
WorkingDirectory=%h/.local/share/qllama/runtime
Environment=MT5_BRIDGE_BIND=0.0.0.0
# Wine needs an X display only for the on-demand boot path, where
# mt5.initialize() starts a terminal because none is running and a platform
# session is open. PassEnvironment takes the values the desktop session
# imported, so nothing is hardcoded to :0.
PassEnvironment=DISPLAY XAUTHORITY
ExecStart=/bin/bash -lc 'exec scripts/start_mt5_bridge.sh'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
