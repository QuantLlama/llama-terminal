# EditorConfig — https://editorconfig.org
# Applies to every file in the repository unless a nested .editorconfig overrides it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{js,jsx,json,yml,yaml,css,html,md}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{sh,service}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
